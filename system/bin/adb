#!/usr/bin/env bash
# adb ARGUMENTS...: the PC's Android tool (install the game on a phone plugged in over USB: adb install -r game.apk).
. "$(dirname "$0")/_common.sh"
passer_par_le_pont "$@"
if [ "$MAC" = 1 ]; then
  for exe in "$KIT/tools/mac/android-sdk/platform-tools/adb" "${ANDROID_SDK_DIR:-/nulle-part}/platform-tools/adb" \
             /opt/homebrew/bin/adb /usr/local/bin/adb; do   # (Homebrew's: brew install android-platform-tools)
    [ -x "$exe" ] && exec "$exe" "$@"
  done
  absent "adb (SDK Android)"
fi
for exe in "$KIT/tools/windows/android-sdk/platform-tools/adb.exe" "${ANDROID_SDK_DIR:-/nulle-part}/platform-tools/adb.exe"; do
  [ -f "$exe" ] && { convertir_args "$@"; exec "$exe" "${ARGS[@]}"; }
done
absent "adb (SDK Android)"
