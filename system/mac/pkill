#!/usr/bin/env bash
# macOS: the pkill of macOS knows no session (-s). The form the scripts use, pkill [-SIGNAL] -s SID,
# signals every process of that session (os.getsid), the way the pilot stops a cycle and everything it
# started; any other form goes to the real pkill. Exit code: 0 if a process was signalled, 1 otherwise.
signal=TERM; sid=""; autres=()
while [ $# -gt 0 ]; do
  case "$1" in
    -s) sid="${2:-}"; [ $# -ge 2 ] || { echo "pkill: -s needs a session" >&2; exit 2; }; shift 2 ;;
    -[A-Z]*|-[0-9]*) signal="${1#-}"; autres+=("$1"); shift ;;
    *) autres+=("$1"); shift ;;
  esac
done
[ -n "$sid" ] || exec /usr/bin/pkill "${autres[@]}"
[[ "$sid" =~ ^[0-9]{2,9}$ ]] || { echo "pkill: invalid session: $sid" >&2; exit 2; }
exec python3 -I -c '
import os, signal, subprocess, sys
nom, sid = sys.argv[1], int(sys.argv[2])
sig = int(nom) if nom.isdigit() else getattr(signal, "SIG" + nom.upper().removeprefix("SIG"), None)
if sig is None:
    print("pkill: unknown signal " + nom, file=sys.stderr); sys.exit(2)
moi, touche = os.getpid(), False
for ligne in subprocess.run(["/bin/ps", "-A", "-o", "pid="], capture_output=True, text=True).stdout.split():
    try:
        p = int(ligne)
        if p != moi and os.getsid(p) == sid:
            os.kill(p, sig); touche = True
    except (ValueError, OSError):
        pass
sys.exit(0 if touche else 1)
' "$signal" "$sid"
